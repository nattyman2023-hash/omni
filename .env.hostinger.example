# Hostinger temporary review environment. Keep values in Hostinger's environment UI.
# Never commit .env, .env.local or real credentials.
NODE_ENV=production
PORT=
APP_URL=
TRUST_PROXY=1
COOKIE_SECURE=true
STAGING_MODE=true
OUTBOUND_MESSAGES_ENABLED=false

# Existing application convention for MySQL.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Required before production staff authentication is enabled. Generate a long,
# random value in Hostinger and never commit the real value.
SESSION_SECRET=

# Optional one-time first administrator bootstrap. Remove the password after login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Keep outbound integrations disabled until an approved provider is configured.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

PUBLIC_PHONE=
PUBLIC_EMAIL=
PUBLIC_WHATSAPP=
UPLOAD_DIR=
PROJECT_UPLOAD_DIR=
UPLOAD_MAX_FILE_SIZE=8388608

# Google reCAPTCHA v2 ("I'm not a robot") on the contact and quote forms.
# Enforced only when both are set. The secret key must never be committed.
RECAPTCHA_SITE_KEY=6LfxZAYuAAAAAEJXtMtdUpUuDmlgPdR82bH11FS9
RECAPTCHA_SECRET_KEY=
