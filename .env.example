NODE_ENV=
PORT=
APP_URL=
TRUST_PROXY=
COOKIE_SECURE=
STAGING_MODE=false
OUTBOUND_MESSAGES_ENABLED=false
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
SESSION_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Outbound email (SMTP) and inbound mailbox (IMAP) for the CRM sales tools.
# Use the mailbox on your own domain, e.g. admin@omnidevelopment.co.uk.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Omni Developments <admin@omnidevelopment.co.uk>"
EMAIL_REPLY_TO=admin@omnidevelopment.co.uk
ADMIN_NOTIFICATION_EMAIL=admin@omnidevelopment.co.uk
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Public base URL used for e-signature links (defaults to APP_URL).
SIGNING_BASE_URL=
# Local development only, when no MySQL is configured. Ignored in production.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
PUBLIC_PHONE=
PUBLIC_EMAIL=
PUBLIC_WHATSAPP=
UPLOAD_DIR=
PROJECT_UPLOAD_DIR=
UPLOAD_MAX_FILE_SIZE=

# Google reCAPTCHA v2 ("I'm not a robot") on the contact and quote forms.
