{
  "name": "omni-development-site",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"tsx server/server.ts\"",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node dist-server/server.js",
    "test": "node scripts/generate-schema.cjs --check && vitest run --config vitest.config.mts",
    "test:mysql": "vitest run --config vitest.mysql.config.mts",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p server/tsconfig.test.json --noEmit",
    "lint": "tsc -p client/tsconfig.json --noEmit",
    "db:migrate": "node scripts/migrate.js",
    "db:schema:generate": "node scripts/generate-schema.cjs",
    "db:schema:check": "node scripts/generate-schema.cjs --check"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.40.0",
    "multer": "^2.3.0",
    "mysql2": "^3.24.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
